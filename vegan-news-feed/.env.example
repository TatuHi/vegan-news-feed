# Malli ymparistomuuttujatiedostolle. Tama tiedosto EI sisalla oikeaa
# salaisuutta ja se on tarkoitettu committoitavaksi mukaan - kopioi se
# oikeaan paikkaan ja taytta oikea arvo, ala koskaan tayta oikeaa arvoa
# tahan tiedostoon.
#
# Kaytto:
#   mkdir -p ~/.config/vegan-news
#   cp .env.example ~/.config/vegan-news/.env
#   chmod 600 ~/.config/vegan-news/.env
#   # muokkaa ~/.config/vegan-news/.env ja laita oikea webhook-URL
#
# scripts/run_daily.sh lukee taman tiedoston ~/.config/vegan-news/.env -
# polusta, ei tasta kansiosta - ks. SKILL.md "Ajastaminen".

DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/REPLACE_WITH_YOUR_OWN"
