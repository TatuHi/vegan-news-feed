# Malli ymparistomuuttujatiedostolle. Tama tiedosto EI sisalla oikeaa
# salaisuutta ja se on tarkoitettu committoitavaksi mukaan - kopioi se
# oikeaan paikkaan ja taytta oikea arvo, ala koskaan tayta oikeaa arvoa
# tahan tiedostoon.
#
# Kaytto:
#   mkdir -p ~/.config/vegan-literature
#   cp .env.example ~/.config/vegan-literature/.env
#   chmod 600 ~/.config/vegan-literature/.env
#   # muokkaa ~/.config/vegan-literature/.env ja laita oikea webhook-URL
#
# Tallahetkella sama webhook-arvo kuin vegan-news-feed:lla toimii ihan
# hyvin testausmielessa (ks. SKILL.md vaihe 6 ja PROCESS.md) - eri
# kanavalle siirtyminen on myohemmin pelkka arvon vaihto tahan tiedostoon,
# ei koodimuutos.

DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/REPLACE_WITH_YOUR_OWN"
